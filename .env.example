# Copy to .env and fill in. .env is gitignored: never commit it.

# Workshop AWS credentials (from the organisers' channel; they expire)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-south-2
EKS_CLUSTER=hack-hyd

# Shared gpt-oss-20b endpoint (from the organisers), used for report analysis
GPTOSS_BASE_URL=

# Web UI team password. When set, the browser asks for it once (any username).
# Leave empty only on a network you trust.
SWORDNET_UI_PASSWORD=
